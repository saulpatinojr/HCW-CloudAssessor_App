# Cloud Assessor appliance edition: every environment variable the application reads, with no values.
# Copy to .env for a local run under `az login`; Terraform (infrastructure/terraform/appliance-azure) sets the hosted
# values on the Container App. Never commit a .env file; never put a client secret anywhere (identity.py refuses it).

# Allow-list of scopes the appliance may read: /subscriptions/<guid> or /subscriptions/<guid>/resourceGroups/<name>,
# comma or space separated. Required; the appliance refuses to start without it.
CA_SCOPES=

# Client id of the user-assigned managed identity (Terraform sets it). Unset locally: DefaultAzureCredential then uses
# the `az login` session. No other AZURE_* variable is read; AZURE_CLIENT_SECRET, AZURE_TENANT_ID, AZURE_USERNAME,
# AZURE_PASSWORD and AZURE_CLIENT_CERTIFICATE_PATH are refused at startup.
AZURE_CLIENT_ID=

# Listening port inside the container (Container Apps ingress targets 8080).
PORT=8080

# Timer interval for collection, in minutes.
CA_REFRESH_MINUTES=60

# 0 disables the Cost Management collector; the cost criteria then stay unknown.
CA_COST_ENABLED=1

# Release gate: results routes answer 403 results_not_public until this is `true` (REVIEW.md R-006 and R-009).
CA_PUBLIC_RESULTS=false

# Microsoft Entra ID sign-in (REVIEW.md R-009 option b, TODO.md T-032). Off by default. When `true`, every route except
# GET /api/health needs `Authorization: Bearer <access token>`; the app refuses to start unless the tenant, audience and
# authority host below are set, and CA_PUBLIC_RESULTS=true refuses to start without it. Public keys only, no secret.
CA_AUTH_ENABLED=false
# Tenant (directory) id, a GUID. Tokens from any other tenant are refused.
CA_AUTH_TENANT_ID=
# Accepted audience(s), space or comma separated: the application (client) id GUID and/or the api:// URI of the app registration.
CA_AUTH_AUDIENCE=
# Host name of the Entra sign-in authority (no https://, no path); builds the issuer and the signing-key (JWKS) address.
CA_AUTH_AUTHORITY_HOST=
# Optional https address of the signing keys instead of the one built from the host and tenant (tests, sovereign clouds).
CA_AUTH_JWKS_URL=
# Allowed clock difference for exp and nbf, in seconds (0 to 300).
CA_AUTH_CLOCK_SKEW_SECONDS=60
# The token must carry one of these app roles (roles claim) or delegated scopes (scp claim). Default Assessment.Read.
CA_AUTH_REQUIRED_ROLES=Assessment.Read
CA_AUTH_REQUIRED_SCOPES=Assessment.Read

# Content-Security-Policy frame-ancestors. Default 'none' (also sends X-Frame-Options: DENY).
CA_FRAME_ANCESTORS='none'

# Site origins the pane may post hcw-addon messages to, space-separated (served by /api/health as siteOrigins).
CA_SITE_ORIGINS=

# Exact origins allowed by CORS, space-separated. Empty: the pane is same-origin with its API.
CA_ALLOWED_ORIGINS=

# 1 when the LAST X-Forwarded-For value (the one the trusted reverse proxy appended) is the client address; only
# behind exactly one trusted proxy.
CA_TRUST_PROXY=0

# Human-verification public site key, published by /api/health; and the secret that enables verification on
# POST /api/refresh (a Container Apps secret reference, never a plain value). Never commit a value.
CA_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Per-client token bucket on POST /api/refresh.
CA_RATE_LIMIT_POSTS=1
CA_RATE_LIMIT_WINDOW_MINUTES=10

# Global cooldown on POST /api/refresh shared by every client address.
CA_REFRESH_COOLDOWN_MINUTES=10

# Resource Graph paging, the memory guard on a collection, and the wall-clock bound on one collection (both
# collectors together); a run past it is abandoned, the previous snapshot stays current and /api/health reports
# lastError "timeout".
CA_PAGE_SIZE=1000
CA_MAX_ROWS=50000
CA_COLLECT_TIMEOUT_SECONDS=900

# 1 silences the JSON log lines on stderr (tests).
CA_LOG_SILENT=0

# Override the static pane directory (default: web/ beside the package).
CA_STATIC_DIR=
